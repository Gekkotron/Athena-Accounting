# Copy this file to `.env` and fill in real values before running docker compose.
# All defaults below are placeholders — do NOT use them in production.

# --- PostgreSQL ---
POSTGRES_USER=athena
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=athena

# --- Backend ---
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters-please

# Host ports. Both services bind to every host interface (0.0.0.0) so other
# devices on your LAN can reach the app at http://<host-ip>:${FRONTEND_PORT};
# see SECURITY.md ("Threat model") before exposing beyond the host. To keep
# access local, restrict with a host firewall, or edit docker-compose.yml
# and prefix the ports with "127.0.0.1:" (e.g. "127.0.0.1:8000:80").
# The frontend proxies API calls to the backend via nginx.
# Avoid 6000 / 6666 / 6665-6669 / 6697 — Chrome blocks them as ERR_UNSAFE_PORT.
FRONTEND_PORT=8000
BACKEND_PORT=8001

# Set to true when running behind an HTTPS-terminating reverse proxy. On a
# plain-HTTP LAN deployment, leave false — otherwise the session cookie is
# rejected by the browser and login silently fails.
COOKIE_SECURE=false

# Bearer token for /metrics. When set (>= 16 chars), the endpoint requires
# `Authorization: Bearer <token>`; when unset, /metrics is public and a
# startup warning is logged. Generate with `openssl rand -hex 32`.
# METRICS_TOKEN=replace-me-with-at-least-16-random-characters

# Opt-in watch-folder importer. When set, the backend polls this directory
# every 60 s and imports any .ofx/.qfx/.csv/.pdf dropped into a subfolder
# named after the destination account (case- and accent-insensitive), e.g.
# $WATCH_IMPORTS_DIR/Compte courant/mai.pdf. Files are renamed in place to
# record the outcome: .imported, .failed (+ a sibling .error.txt), or
# .needs-template for PDFs that still need the interactive wizard. In Docker,
# mount the folder into the backend container and point this at the mount.
# WATCH_IMPORTS_DIR=/data/watch-imports

# Nightly unattended bank sync (Enable Banking connector). When credentials
# are configured in Réglages, the backend syncs every mapped bank connection
# once a day. Set to 0 to disable the scheduler and only sync on demand from
# the UI (POST /api/bank-sync/sync).
# BANK_SYNC_AUTO=1

# Timezone of the backend container (IANA name, e.g. Europe/Paris). Without
# it the container runs on UTC, so schedule-based features — notably the
# bank-sync "retrieval hour" — fire at UTC hours instead of your wall-clock
# time (09:00 configured → 11:00 CEST). Set it to your server's timezone.
# TZ=Europe/Paris
